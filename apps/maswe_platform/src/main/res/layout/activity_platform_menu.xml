<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    tools:context="com.dkronig.maswe_platform.PlatformMenu">

    <LinearLayout
        android:id="@+id/button_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="20dp">

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chose Vulnerability Category"
            android:textSize="24sp"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginTop="55dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <Button
            android:id="@+id/maswe_0053_button"
            android:layout_width="@dimen/maswe_button_width"
            android:layout_height="wrap_content"
            android:text="maswe_0053"
            app:layout_constraintTop_toBottomOf="@+id/title"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="55dp" />

        <Button
            android:id="@+id/maswe_0055_button"
            android:layout_width="@dimen/maswe_button_width"
            android:layout_height="wrap_content"
            android:text="maswe_0055"
            app:layout_constraintTop_toBottomOf="@+id/maswe_0053_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/maswe_0064_button"
            android:layout_width="@dimen/maswe_button_width"
            android:layout_height="wrap_content"
            android:text="maswe_0064"
            app:layout_constraintTop_toBottomOf="@+id/maswe_0055_button"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="20dp" />

    </LinearLayout>
</ScrollView>