<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    package="com.dkronig.maswe_storage">

    <application
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.maswe_storage"
        tools:targetApi="31">

        <!-- Main Launcher Activity -->
        <activity
            android:name="com.dkronig.maswe_storage.StorageMenu"
            android:theme="@style/Theme.maswe_storage"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- MASWE-0001 -->
        <activity
            android:name="com.dkronig.maswe_storage.maswe_0001.MainActivity0001"
            android:theme="@style/Theme.maswe_storage" />

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0001.LoginActivity"
            android:theme="@style/Theme.maswe_storage"/>

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0001.RegisterActivity"
            android:theme="@style/Theme.maswe_storage" />

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0001.ProfileActivity"
            android:theme="@style/Theme.maswe_storage"/>

        <!-- MASWE-0002 -->
        <activity
            android:name="com.dkronig.maswe_storage.maswe_0002.MainActivity0002"
            android:theme="@style/Theme.maswe_storage" />

        <!--
            Misconfigured custom file provider for MASWE-0002, that grands URI permissions
            without checking the permissions required.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.dkronig.maswe_storage.CustomFileProvider"
            android:exported="false"
            android:grantUriPermissions="true"
            android:permission="" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0002.LoginActivity"
            android:theme="@style/Theme.maswe_storage"/>

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0002.RegisterActivity"
            android:theme="@style/Theme.maswe_storage" />

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0002.ProfileActivity"
            android:theme="@style/Theme.maswe_storage"/>

        <!-- MASWE-0006 -->
        <activity
            android:name="com.dkronig.maswe_storage.maswe_0006.MainActivity0006"
            android:theme="@style/Theme.maswe_storage" />

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0006.LoginActivity"
            android:theme="@style/Theme.maswe_storage"/>

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0006.RegisterActivity"
            android:theme="@style/Theme.maswe_storage" />

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0006.ProfileActivity"
            android:theme="@style/Theme.maswe_storage"/>

        <!-- MASWE-0007 -->
        <activity
            android:name="com.dkronig.maswe_storage.maswe_0007.MainActivity0007"
            android:theme="@style/Theme.maswe_storage" />

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0007.LoginActivity"
            android:theme="@style/Theme.maswe_storage"/>

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0007.RegisterActivity"
            android:theme="@style/Theme.maswe_storage" />

        <activity
            android:name="com.dkronig.maswe_storage.maswe_0007.ProfileActivity"
            android:theme="@style/Theme.maswe_storage"/>

    </application>

</manifest>